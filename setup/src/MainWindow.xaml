<Window x:Class="AIPulseSetup.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Quillwave Setup" Width="720" Height="500"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ResizeMode="NoResize" WindowStartupLocation="CenterScreen"
        UseLayoutRounding="True" TextOptions.TextFormattingMode="Display"
        FontFamily="Segoe UI Variable Text, Segoe UI" FontSize="13" Foreground="#E8EEE8">

  <Window.Resources>
    <LinearGradientBrush x:Key="Grad" StartPoint="0,0" EndPoint="1,1">
      <GradientStop Color="#3D5AFE" Offset="0"/>
      <GradientStop Color="#8B5CF6" Offset="0.5"/>
      <GradientStop Color="#F06FA4" Offset="0.8"/>
      <GradientStop Color="#FF9A55" Offset="1"/>
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="TitleGrad" StartPoint="0,0" EndPoint="1,0">
      <GradientStop Color="#FFFFFF" Offset="0"/>
      <GradientStop Color="#C9C2FF" Offset="0.6"/>
      <GradientStop Color="#FFB3D1" Offset="1"/>
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="DangerGrad" StartPoint="0,0" EndPoint="1,1">
      <GradientStop Color="#FF5A52" Offset="0"/>
      <GradientStop Color="#C2304A" Offset="1"/>
    </LinearGradientBrush>
    <SolidColorBrush x:Key="Muted" Color="#9AA6B8"/>
    <SolidColorBrush x:Key="Glass" Color="#14FFFFFF"/>
    <SolidColorBrush x:Key="Edge" Color="#22FFFFFF"/>
    <FontFamily x:Key="Display">Bahnschrift SemiBold, Segoe UI Semibold</FontFamily>

    <!-- big gradient pill with a breathing glow, grows a little on hover -->
    <Style x:Key="Primary" TargetType="Button">
      <Setter Property="Foreground" Value="White"/>
      <Setter Property="FontSize" Value="15"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="Padding" Value="44,13"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Background" Value="{StaticResource Grad}"/>
      <Setter Property="RenderTransformOrigin" Value="0.5,0.5"/>
      <Setter Property="RenderTransform"><Setter.Value><ScaleTransform/></Setter.Value></Setter>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Grid>
              <Border x:Name="halo" CornerRadius="18" Background="{TemplateBinding Background}" Opacity="0.55" Margin="-2">
                <Border.Effect><BlurEffect Radius="22"/></Border.Effect>
                <Border.Triggers>
                  <EventTrigger RoutedEvent="Loaded">
                    <BeginStoryboard><Storyboard RepeatBehavior="Forever" AutoReverse="True">
                      <DoubleAnimation Storyboard.TargetProperty="Opacity" From="0.35" To="0.8" Duration="0:0:1.6"><DoubleAnimation.EasingFunction><SineEase/></DoubleAnimation.EasingFunction></DoubleAnimation>
                    </Storyboard></BeginStoryboard>
                  </EventTrigger>
                </Border.Triggers>
              </Border>
              <Border x:Name="b" CornerRadius="18" Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}" BorderBrush="#40FFFFFF" BorderThickness="1">
                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
              </Border>
            </Grid>
            <ControlTemplate.Triggers>
              <EventTrigger RoutedEvent="MouseEnter">
                <BeginStoryboard><Storyboard>
                  <DoubleAnimation Storyboard.TargetProperty="RenderTransform.ScaleX" To="1.06" Duration="0:0:0.25"><DoubleAnimation.EasingFunction><BackEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction></DoubleAnimation>
                  <DoubleAnimation Storyboard.TargetProperty="RenderTransform.ScaleY" To="1.06" Duration="0:0:0.25"><DoubleAnimation.EasingFunction><BackEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction></DoubleAnimation>
                </Storyboard></BeginStoryboard>
              </EventTrigger>
              <EventTrigger RoutedEvent="MouseLeave">
                <BeginStoryboard><Storyboard>
                  <DoubleAnimation Storyboard.TargetProperty="RenderTransform.ScaleX" To="1" Duration="0:0:0.2"/>
                  <DoubleAnimation Storyboard.TargetProperty="RenderTransform.ScaleY" To="1" Duration="0:0:0.2"/>
                </Storyboard></BeginStoryboard>
              </EventTrigger>
              <Trigger Property="IsPressed" Value="True"><Setter TargetName="b" Property="Opacity" Value="0.85"/></Trigger>
              <Trigger Property="IsEnabled" Value="False"><Setter TargetName="b" Property="Opacity" Value="0.45"/><Setter TargetName="halo" Property="Visibility" Value="Collapsed"/></Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style x:Key="Ghost" TargetType="Button">
      <Setter Property="Foreground" Value="#E8EEE8"/>
      <Setter Property="Padding" Value="18,9"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="b" CornerRadius="13" Background="{StaticResource Glass}" BorderBrush="{StaticResource Edge}" BorderThickness="1" Padding="{TemplateBinding Padding}">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="b" Property="Background" Value="#26FFFFFF"/></Trigger>
              <Trigger Property="IsPressed" Value="True"><Setter TargetName="b" Property="Opacity" Value="0.8"/></Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style x:Key="Link" TargetType="Button">
      <Setter Property="Foreground" Value="#B4BCFF"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <TextBlock x:Name="t" Text="{TemplateBinding Content}" Foreground="{TemplateBinding Foreground}"/>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="t" Property="TextDecorations" Value="Underline"/></Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style x:Key="Chrome" TargetType="Button">
      <Setter Property="Width" Value="34"/>
      <Setter Property="Height" Value="30"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="b" CornerRadius="10" Background="Transparent">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="b" Property="Background" Value="#1FFFFFFF"/></Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style x:Key="Switch" TargetType="CheckBox">
      <Setter Property="Foreground" Value="#E8EEE8"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="CheckBox">
            <StackPanel Orientation="Horizontal" Background="Transparent">
              <Grid Width="36" Height="20" VerticalAlignment="Center">
                <Border x:Name="track" CornerRadius="10" Background="#33FFFFFF"/>
                <Ellipse Width="16" Height="16" Fill="White" HorizontalAlignment="Left" Margin="2,0,0,0">
                  <Ellipse.RenderTransform><TranslateTransform x:Name="kx"/></Ellipse.RenderTransform>
                </Ellipse>
              </Grid>
              <ContentPresenter Margin="10,0,0,0" VerticalAlignment="Center"/>
            </StackPanel>
            <ControlTemplate.Triggers>
              <Trigger Property="IsChecked" Value="True">
                <Setter TargetName="track" Property="Background" Value="{StaticResource Grad}"/>
                <Trigger.EnterActions><BeginStoryboard><Storyboard><DoubleAnimation Storyboard.TargetName="kx" Storyboard.TargetProperty="X" To="16" Duration="0:0:0.25"><DoubleAnimation.EasingFunction><BackEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction></DoubleAnimation></Storyboard></BeginStoryboard></Trigger.EnterActions>
                <Trigger.ExitActions><BeginStoryboard><Storyboard><DoubleAnimation Storyboard.TargetName="kx" Storyboard.TargetProperty="X" To="0" Duration="0:0:0.2"/></Storyboard></BeginStoryboard></Trigger.ExitActions>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style x:Key="Field" TargetType="TextBox">
      <Setter Property="Foreground" Value="#E8EEE8"/>
      <Setter Property="CaretBrush" Value="#B4BCFF"/>
      <Setter Property="Background" Value="#12FFFFFF"/>
      <Setter Property="BorderBrush" Value="{StaticResource Edge}"/>
      <Setter Property="Padding" Value="9,7"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="TextBox">
            <Border CornerRadius="11" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1">
              <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}"/>
            </Border>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style x:Key="Chip" TargetType="Border">
      <Setter Property="CornerRadius" Value="14"/>
      <Setter Property="Background" Value="{StaticResource Glass}"/>
      <Setter Property="BorderBrush" Value="{StaticResource Edge}"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="Padding" Value="11,5"/>
      <Setter Property="Margin" Value="4,0"/>
    </Style>
  </Window.Resources>

  <Grid x:Name="Shell" Margin="20" RenderTransformOrigin="0.5,0.5" Opacity="0">
    <Grid.RenderTransform><ScaleTransform x:Name="ShellScale" ScaleX="0.94" ScaleY="0.94"/></Grid.RenderTransform>
    <Border CornerRadius="28" Background="#090C14">
      <Border.Effect><DropShadowEffect BlurRadius="36" ShadowDepth="8" Opacity="0.6" Color="Black"/></Border.Effect>
    </Border>

    <Grid x:Name="Card">
      <!-- deep background: drifting colour, then a field of floating particles -->
      <Canvas x:Name="Aurora" IsHitTestVisible="False">
        <Ellipse x:Name="B1" Width="420" Height="420" Fill="#3D5AFE" Opacity="0.55" Canvas.Left="-150" Canvas.Top="-200"><Ellipse.Effect><BlurEffect Radius="130"/></Ellipse.Effect></Ellipse>
        <Ellipse x:Name="B2" Width="380" Height="380" Fill="#8B5CF6" Opacity="0.5" Canvas.Left="420" Canvas.Top="220"><Ellipse.Effect><BlurEffect Radius="130"/></Ellipse.Effect></Ellipse>
        <Ellipse x:Name="B3" Width="300" Height="300" Fill="#F06FA4" Opacity="0.28" Canvas.Left="470" Canvas.Top="-140"><Ellipse.Effect><BlurEffect Radius="120"/></Ellipse.Effect></Ellipse>
        <Ellipse x:Name="B4" Width="260" Height="260" Fill="#22D3EE" Opacity="0.18" Canvas.Left="-80" Canvas.Top="300"><Ellipse.Effect><BlurEffect Radius="120"/></Ellipse.Effect></Ellipse>
      </Canvas>
      <Canvas x:Name="Stars" IsHitTestVisible="False"/>
      <Canvas x:Name="Burst" IsHitTestVisible="False"/>
      <Border CornerRadius="28" BorderThickness="1" IsHitTestVisible="False">
        <Border.BorderBrush>
          <LinearGradientBrush StartPoint="0,0" EndPoint="1,1"><GradientStop Color="#40FFFFFF" Offset="0"/><GradientStop Color="#0AFFFFFF" Offset="0.5"/><GradientStop Color="#30FFFFFF" Offset="1"/></LinearGradientBrush>
        </Border.BorderBrush>
      </Border>

      <!-- title bar -->
      <Grid x:Name="TitleBar" Height="46" VerticalAlignment="Top" Background="Transparent">
        <TextBlock Text="QUILLWAVE  ·  SETUP" Foreground="#7F8AA0" FontSize="10.5" FontWeight="SemiBold" Margin="22,0,0,0" VerticalAlignment="Center"/>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,0,12,0">
          <Button x:Name="MinBtn" Style="{StaticResource Chrome}" ToolTip="Minimize"><Path Data="M0,0 H10" Stroke="#B9C4D0" StrokeThickness="1.4"/></Button>
          <Button x:Name="CloseBtn" Style="{StaticResource Chrome}" ToolTip="Close"><Path Data="M0,0 L10,10 M10,0 L0,10" Stroke="#B9C4D0" StrokeThickness="1.4"/></Button>
        </StackPanel>
      </Grid>

      <!-- the logo: orbit rings, a satellite, and the progress ring around it -->
      <Grid x:Name="LogoHost" Width="170" Height="170" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,32,0,0" RenderTransformOrigin="0.5,0.5">
        <Grid.RenderTransform><TransformGroup><ScaleTransform x:Name="LogoScale" ScaleX="0.4" ScaleY="0.4"/><TranslateTransform x:Name="LogoFloat"/></TransformGroup></Grid.RenderTransform>
        <Ellipse x:Name="OrbitA" Width="166" Height="166" StrokeThickness="1" StrokeDashArray="2 6" RenderTransformOrigin="0.5,0.5" Opacity="0.55">
          <Ellipse.Stroke><LinearGradientBrush StartPoint="0,0" EndPoint="1,1"><GradientStop Color="#B4BCFF" Offset="0"/><GradientStop Color="#00B4BCFF" Offset="1"/></LinearGradientBrush></Ellipse.Stroke>
          <Ellipse.RenderTransform><RotateTransform x:Name="OrbitARot"/></Ellipse.RenderTransform>
        </Ellipse>
        <Ellipse x:Name="OrbitB" Width="142" Height="142" StrokeThickness="1.2" RenderTransformOrigin="0.5,0.5" Opacity="0.4">
          <Ellipse.Stroke><LinearGradientBrush StartPoint="1,0" EndPoint="0,1"><GradientStop Color="#F06FA4" Offset="0"/><GradientStop Color="#003D5AFE" Offset="0.7"/></LinearGradientBrush></Ellipse.Stroke>
          <Ellipse.RenderTransform><RotateTransform x:Name="OrbitBRot"/></Ellipse.RenderTransform>
        </Ellipse>
        <Canvas Width="170" Height="170" RenderTransformOrigin="0.5,0.5">
          <Canvas.RenderTransform><RotateTransform x:Name="SatRot"/></Canvas.RenderTransform>
          <Ellipse Width="9" Height="9" Fill="#FFD6E8" Canvas.Left="80.5" Canvas.Top="0">
            <Ellipse.Effect><DropShadowEffect Color="#F06FA4" BlurRadius="14" ShadowDepth="0" Opacity="1"/></Ellipse.Effect>
          </Ellipse>
        </Canvas>
        <!-- progress ring (drawn in code), with its track -->
        <Ellipse x:Name="ArcTrack" Width="150" Height="150" Stroke="#1AFFFFFF" StrokeThickness="4" Opacity="0"/>
        <Path x:Name="ProgressArc" StrokeThickness="4.5" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Stroke="{StaticResource Grad}" Width="170" Height="170">
          <Path.Effect><DropShadowEffect Color="#8B5CF6" BlurRadius="18" ShadowDepth="0" Opacity="0.95"/></Path.Effect>
        </Path>
        <Border Width="96" Height="96" CornerRadius="30" Background="{StaticResource Grad}">
          <Border.Effect><DropShadowEffect x:Name="LogoGlow" Color="#8B5CF6" BlurRadius="46" ShadowDepth="0" Opacity="0.75"/></Border.Effect>
          <Viewbox Margin="21">
            <Canvas Width="24" Height="24">
              <Path x:Name="PulseLine" Data="M2,13 H5 L7,7 L10,19 L13,5 L16,15 L18,11 H22" Stroke="White" StrokeThickness="2.2"
                    StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeDashArray="34 34" StrokeDashOffset="34"/>
            </Canvas>
          </Viewbox>
        </Border>
      </Grid>

      <Grid x:Name="Pages" Margin="40,206,40,34">

        <!-- welcome -->
        <StackPanel x:Name="WelcomePage" Visibility="Collapsed" VerticalAlignment="Top">
          <TextBlock Text="Quillwave" FontFamily="{StaticResource Display}" FontSize="40" HorizontalAlignment="Center" Foreground="{StaticResource TitleGrad}"/>
          <TextBlock Text="The day's AI news, briefed and personalised, on your desktop." Foreground="{StaticResource Muted}" FontSize="14" HorizontalAlignment="Center" Margin="0,2,0,0"/>
          <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,14,0,0">
            <Border Style="{StaticResource Chip}"><TextBlock Text="Nearly 100 sources" FontSize="11.5" Foreground="#C9D0DC"/></Border>
            <Border Style="{StaticResource Chip}"><TextBlock Text="Instant AI briefs" FontSize="11.5" Foreground="#C9D0DC"/></Border>
            <Border Style="{StaticResource Chip}"><TextBlock Text="A feed made for you" FontSize="11.5" Foreground="#C9D0DC"/></Border>
          </StackPanel>
          <Button x:Name="InstallBtn" Style="{StaticResource Primary}" HorizontalAlignment="Center" Margin="0,18,0,0">
            <StackPanel Orientation="Horizontal">
              <TextBlock Text="Install Quillwave"/>
              <Path Data="M0,4 H9 M6,0 L10,4 L6,8" Stroke="White" StrokeThickness="1.8" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" Margin="10,0,0,0" VerticalAlignment="Center"/>
            </StackPanel>
          </Button>
          <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,14,0,0">
            <TextBlock x:Name="VersionText" Foreground="#7F8AA0" FontSize="12"/>
            <TextBlock Text="  ·  " Foreground="#7F8AA0" FontSize="12"/>
            <Button x:Name="OptionsBtn" Style="{StaticResource Link}" Content="Install options" FontSize="12"/>
          </StackPanel>
          <Border x:Name="OptionsPanel" Visibility="Collapsed" CornerRadius="16" Background="{StaticResource Glass}" BorderBrush="{StaticResource Edge}" BorderThickness="1" Padding="16,13" Margin="20,14,20,0">
            <StackPanel>
              <TextBlock Text="Install to" Foreground="{StaticResource Muted}" FontSize="12" Margin="0,0,0,6"/>
              <DockPanel>
                <Button x:Name="BrowseBtn" Style="{StaticResource Ghost}" Content="Browse…" DockPanel.Dock="Right" Margin="8,0,0,0" Padding="13,7"/>
                <TextBox x:Name="DirBox" Style="{StaticResource Field}"/>
              </DockPanel>
              <CheckBox x:Name="DesktopBox" Style="{StaticResource Switch}" Content="Create a desktop shortcut" IsChecked="True" Margin="0,11,0,0"/>
            </StackPanel>
          </Border>
        </StackPanel>

        <!-- progress: the ring is around the logo above -->
        <StackPanel x:Name="ProgressPage" Visibility="Collapsed" VerticalAlignment="Top">
          <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
            <TextBlock x:Name="PercentText" Text="0" FontFamily="{StaticResource Display}" FontSize="46" Foreground="{StaticResource TitleGrad}"/>
            <TextBlock Text="%" FontFamily="{StaticResource Display}" FontSize="22" Foreground="#9AA6B8" Margin="3,0,0,8" VerticalAlignment="Bottom"/>
          </StackPanel>
          <TextBlock x:Name="ProgressTitle" Text="Installing Quillwave" FontFamily="{StaticResource Display}" FontSize="17" HorizontalAlignment="Center" Margin="0,-2,0,0"/>
          <TextBlock x:Name="StatusText" Text="Getting ready…" Foreground="#7F8AA0" FontSize="11.5" HorizontalAlignment="Center" Margin="0,6,0,0" TextTrimming="CharacterEllipsis" MaxWidth="520"/>
          <Border Style="{StaticResource Chip}" HorizontalAlignment="Center" Margin="0,18,0,0" Padding="14,7">
            <StackPanel Orientation="Horizontal">
              <Ellipse Width="6" Height="6" Fill="#B4BCFF" VerticalAlignment="Center" Margin="0,0,8,0"/>
              <TextBlock x:Name="FeatureText" Text="Scanning nearly 100 sources, live" Foreground="#C9D0DC" FontSize="12"/>
            </StackPanel>
          </Border>
        </StackPanel>

        <!-- done -->
        <StackPanel x:Name="DonePage" Visibility="Collapsed" VerticalAlignment="Top">
          <TextBlock x:Name="DoneTitle" Text="Quillwave is ready" FontFamily="{StaticResource Display}" FontSize="30" HorizontalAlignment="Center" Foreground="{StaticResource TitleGrad}" Margin="0,6,0,0"/>
          <TextBlock x:Name="DoneText" Text="Opening it now…" Foreground="{StaticResource Muted}" FontSize="13.5" HorizontalAlignment="Center" Margin="0,6,0,0"/>
        </StackPanel>

        <!-- error -->
        <StackPanel x:Name="ErrorPage" Visibility="Collapsed" VerticalAlignment="Top">
          <TextBlock Text="Something went wrong" FontFamily="{StaticResource Display}" FontSize="26" HorizontalAlignment="Center" Foreground="#FFB4AE"/>
          <TextBlock x:Name="ErrorText" Foreground="{StaticResource Muted}" FontSize="13" TextWrapping="Wrap" TextAlignment="Center" Margin="0,8,0,0" MaxWidth="520"/>
          <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,18,0,0">
            <Button x:Name="RetryBtn" Style="{StaticResource Primary}" Content="Try again" Padding="30,11"/>
            <Button x:Name="ErrorCloseBtn" Style="{StaticResource Ghost}" Content="Close" Margin="12,0,0,0"/>
          </StackPanel>
        </StackPanel>

        <!-- uninstall -->
        <StackPanel x:Name="RemovePage" Visibility="Collapsed" VerticalAlignment="Top">
          <TextBlock Text="Remove Quillwave?" FontFamily="{StaticResource Display}" FontSize="30" HorizontalAlignment="Center" Foreground="{StaticResource TitleGrad}"/>
          <TextBlock Text="The app, its shortcuts and its startup entry will be removed." Foreground="{StaticResource Muted}" FontSize="13.5" HorizontalAlignment="Center" Margin="0,6,0,0"/>
          <CheckBox x:Name="DeleteDataBox" Style="{StaticResource Switch}" Content="Also delete my settings, bookmarks and saved articles" HorizontalAlignment="Center" Margin="0,18,0,0"/>
          <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,22,0,0">
            <Button x:Name="RemoveBtn" Style="{StaticResource Primary}" Content="Remove" Background="{StaticResource DangerGrad}" Padding="34,12"/>
            <Button x:Name="KeepBtn" Style="{StaticResource Ghost}" Content="Keep it" Margin="12,0,0,0" Padding="24,12"/>
          </StackPanel>
        </StackPanel>
      </Grid>

      <TextBlock x:Name="Footnote" VerticalAlignment="Bottom" HorizontalAlignment="Center" Margin="0,0,0,13" FontSize="11" Foreground="#5F6B80"
                 Text="Installs for your account only, no admin needed. You'll accept the terms when Quillwave opens."/>
    </Grid>
  </Grid>
</Window>
