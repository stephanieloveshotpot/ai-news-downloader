<Window x:Class="AIPulseSetup.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Quillwave Setup" Width="680" Height="500"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ResizeMode="NoResize" WindowStartupLocation="CenterScreen"
        UseLayoutRounding="True" TextOptions.TextFormattingMode="Display"
        FontFamily="Segoe UI Variable Text, Segoe UI" FontSize="13" Foreground="#ECEEF3">

  <!-- Calm on purpose: one surface, one accent, a fixed layout (header, content,
       footer). The only things that move are the progress bar and short fades. -->
  <Window.Resources>
    <SolidColorBrush x:Key="Surface" Color="#16171D"/>
    <SolidColorBrush x:Key="Raised" Color="#1E2028"/>
    <SolidColorBrush x:Key="Line" Color="#2C2F3A"/>
    <SolidColorBrush x:Key="Muted" Color="#A3A9B7"/>
    <SolidColorBrush x:Key="Faint" Color="#7D8494"/>
    <SolidColorBrush x:Key="Accent" Color="#7B68F6"/>
    <SolidColorBrush x:Key="AccentHover" Color="#8C7BFF"/>
    <SolidColorBrush x:Key="DangerBrush" Color="#D9434E"/>
    <SolidColorBrush x:Key="DangerHover" Color="#E5545E"/>
    <SolidColorBrush x:Key="Good" Color="#3DC98A"/>
    <SolidColorBrush x:Key="TextBright" Color="#ECEEF3"/>
    <FontFamily x:Key="Display">Segoe UI Variable Display Semibold, Segoe UI Semibold</FontFamily>

    <Style x:Key="Btn" TargetType="Button">
      <Setter Property="Foreground" Value="#ECEEF3"/>
      <Setter Property="Background" Value="#262833"/>
      <Setter Property="BorderBrush" Value="#343745"/>
      <Setter Property="FontSize" Value="13"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="Padding" Value="18,0"/>
      <Setter Property="Height" Value="34"/>
      <Setter Property="MinWidth" Value="96"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="b" CornerRadius="7" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" Padding="{TemplateBinding Padding}">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="b" Property="Background" Value="#2E3140"/></Trigger>
              <Trigger Property="IsPressed" Value="True"><Setter TargetName="b" Property="Opacity" Value="0.85"/></Trigger>
              <Trigger Property="IsEnabled" Value="False"><Setter TargetName="b" Property="Opacity" Value="0.4"/></Trigger>
              <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="b" Property="BorderBrush" Value="#B4A9FF"/></Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style x:Key="Primary" TargetType="Button" BasedOn="{StaticResource Btn}">
      <Setter Property="Foreground" Value="White"/>
      <Setter Property="Background" Value="{StaticResource Accent}"/>
      <Setter Property="BorderBrush" Value="{StaticResource Accent}"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="b" CornerRadius="7" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" Padding="{TemplateBinding Padding}">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="b" Property="Opacity" Value="0.9"/></Trigger>
              <Trigger Property="IsPressed" Value="True"><Setter TargetName="b" Property="Opacity" Value="0.8"/></Trigger>
              <Trigger Property="IsEnabled" Value="False"><Setter TargetName="b" Property="Opacity" Value="0.4"/></Trigger>
              <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="b" Property="BorderBrush" Value="White"/></Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style x:Key="Danger" TargetType="Button" BasedOn="{StaticResource Primary}">
      <Setter Property="Background" Value="{StaticResource DangerBrush}"/>
      <Setter Property="BorderBrush" Value="{StaticResource DangerBrush}"/>
    </Style>
    <Style x:Key="Link" TargetType="Button">
      <Setter Property="Foreground" Value="#B4A9FF"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <TextBlock x:Name="t" Text="{TemplateBinding Content}" Foreground="{TemplateBinding Foreground}"/>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="t" Property="TextDecorations" Value="Underline"/></Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style x:Key="Chrome" TargetType="Button">
      <Setter Property="Width" Value="40"/>
      <Setter Property="Height" Value="32"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="b" CornerRadius="6" Background="Transparent"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="b" Property="Background" Value="#262833"/></Trigger>
              <Trigger Property="IsEnabled" Value="False"><Setter TargetName="b" Property="Opacity" Value="0.35"/></Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style x:Key="Check" TargetType="CheckBox">
      <Setter Property="Foreground" Value="#ECEEF3"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="CheckBox">
            <Grid Background="Transparent">
              <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition/></Grid.ColumnDefinitions>
              <Border x:Name="box" Width="18" Height="18" CornerRadius="4" BorderBrush="#4A4E5E" BorderThickness="1.5" Background="Transparent" VerticalAlignment="Top" Margin="0,1,0,0">
                <Path x:Name="tick" Data="M3.5,9 L7.5,13 L14.5,5" Stroke="White" StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" Visibility="Collapsed"/>
              </Border>
              <ContentPresenter Grid.Column="1" Margin="10,0,0,0" VerticalAlignment="Top"/>
            </Grid>
            <ControlTemplate.Triggers>
              <Trigger Property="IsChecked" Value="True">
                <Setter TargetName="box" Property="Background" Value="{StaticResource Accent}"/>
                <Setter TargetName="box" Property="BorderBrush" Value="{StaticResource Accent}"/>
                <Setter TargetName="tick" Property="Visibility" Value="Visible"/>
              </Trigger>
              <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="box" Property="BorderBrush" Value="#B4A9FF"/></Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style x:Key="Field" TargetType="TextBox">
      <Setter Property="Foreground" Value="#ECEEF3"/>
      <Setter Property="CaretBrush" Value="#B4A9FF"/>
      <Setter Property="Background" Value="#111218"/>
      <Setter Property="Padding" Value="8,6"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="TextBox">
            <Border x:Name="b" CornerRadius="6" Background="{TemplateBinding Background}" BorderBrush="#343745" BorderThickness="1">
              <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}"/>
            </Border>
            <ControlTemplate.Triggers><Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="b" Property="BorderBrush" Value="#7B68F6"/></Trigger></ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <!-- a row in a list: icon, then text -->
    <Style x:Key="Row" TargetType="Grid"><Setter Property="Margin" Value="0,0,0,12"/></Style>
    <Style x:Key="RowTitle" TargetType="TextBlock"><Setter Property="FontSize" Value="13"/><Setter Property="FontWeight" Value="SemiBold"/><Setter Property="TextWrapping" Value="Wrap"/></Style>
    <Style x:Key="RowText" TargetType="TextBlock"><Setter Property="FontSize" Value="12.5"/><Setter Property="Foreground" Value="{StaticResource Muted}"/><Setter Property="TextWrapping" Value="Wrap"/><Setter Property="Margin" Value="0,2,0,0"/></Style>
    <Style x:Key="Label" TargetType="TextBlock"><Setter Property="FontSize" Value="11"/><Setter Property="FontWeight" Value="SemiBold"/><Setter Property="Foreground" Value="{StaticResource Faint}"/><Setter Property="Margin" Value="0,0,0,10"/></Style>
    <Style x:Key="Panel" TargetType="Border"><Setter Property="Background" Value="{StaticResource Raised}"/><Setter Property="BorderBrush" Value="{StaticResource Line}"/><Setter Property="BorderThickness" Value="1"/><Setter Property="CornerRadius" Value="10"/><Setter Property="Padding" Value="16,14,16,4"/></Style>
  </Window.Resources>

  <Grid x:Name="Shell" Margin="16" Opacity="0">
    <Border CornerRadius="12" Background="{StaticResource Surface}" BorderBrush="{StaticResource Line}" BorderThickness="1">
      <Border.Effect><DropShadowEffect BlurRadius="28" ShadowDepth="6" Opacity="0.45" Color="Black"/></Border.Effect>
    </Border>

    <Grid x:Name="Card">
      <Grid.RowDefinitions>
        <RowDefinition Height="40"/>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="*"/>
        <RowDefinition Height="64"/>
      </Grid.RowDefinitions>

      <!-- title bar -->
      <Grid x:Name="TitleBar" Background="Transparent">
        <StackPanel Orientation="Horizontal" Margin="16,0,0,0" VerticalAlignment="Center">
          <Border Width="16" Height="16" CornerRadius="4">
            <Border.Background><LinearGradientBrush StartPoint="0,0" EndPoint="1,1"><GradientStop Color="#3D5AFE" Offset="0"/><GradientStop Color="#8B5CF6" Offset="0.55"/><GradientStop Color="#F06FA4" Offset="1"/></LinearGradientBrush></Border.Background>
            <Viewbox Margin="3"><Canvas Width="24" Height="24"><Path Data="M2,13 H5 L7,7 L10,19 L13,5 L16,15 L18,11 H22" Stroke="White" StrokeThickness="2.6" StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/></Canvas></Viewbox>
          </Border>
          <TextBlock x:Name="WindowTitle" Text="Quillwave Setup" Foreground="{StaticResource Muted}" FontSize="12" Margin="9,0,0,0" VerticalAlignment="Center"/>
        </StackPanel>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,0,6,0">
          <Button x:Name="MinBtn" Style="{StaticResource Chrome}" ToolTip="Minimize" AutomationProperties.Name="Minimize"><Path Data="M0,0 H10" Stroke="#A3A9B7" StrokeThickness="1.2"/></Button>
          <Button x:Name="CloseBtn" Style="{StaticResource Chrome}" ToolTip="Close" AutomationProperties.Name="Close"><Path Data="M0,0 L10,10 M10,0 L0,10" Stroke="#A3A9B7" StrokeThickness="1.2"/></Button>
        </StackPanel>
      </Grid>

      <!-- header: logo, title, one line under it -->
      <Grid Grid.Row="1" Margin="32,10,32,18">
        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition/></Grid.ColumnDefinitions>
        <Grid Width="52" Height="52" VerticalAlignment="Top">
          <Border x:Name="Logo" CornerRadius="13">
            <Border.Background><LinearGradientBrush StartPoint="0,0" EndPoint="1,1"><GradientStop Color="#3D5AFE" Offset="0"/><GradientStop Color="#8B5CF6" Offset="0.55"/><GradientStop Color="#F06FA4" Offset="1"/></LinearGradientBrush></Border.Background>
            <Viewbox Margin="12"><Canvas Width="24" Height="24"><Path Data="M2,13 H5 L7,7 L10,19 L13,5 L16,15 L18,11 H22" Stroke="White" StrokeThickness="2.2" StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/></Canvas></Viewbox>
          </Border>
          <Border x:Name="StateBadge" Width="52" Height="52" CornerRadius="13" Visibility="Collapsed">
            <Path x:Name="StateIcon" Width="24" Height="24" Stretch="Uniform" Stroke="White" StrokeThickness="2.4" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"/>
          </Border>
        </Grid>
        <StackPanel Grid.Column="1" Margin="16,2,0,0" VerticalAlignment="Center">
          <TextBlock x:Name="HeadTitle" Text="Install Quillwave" FontFamily="{StaticResource Display}" FontSize="22"/>
          <TextBlock x:Name="HeadSub" Text="" Foreground="{StaticResource Muted}" FontSize="13" Margin="0,3,0,0" TextTrimming="CharacterEllipsis"/>
        </StackPanel>
      </Grid>

      <Grid x:Name="Pages" Grid.Row="2" Margin="32,0,32,0">

        <!-- install: what will happen -->
        <StackPanel x:Name="WelcomePage" Visibility="Collapsed">
          <TextBlock Text="WHAT HAPPENS" Style="{StaticResource Label}"/>
          <Grid Style="{StaticResource Row}">
            <Grid.ColumnDefinitions><ColumnDefinition Width="28"/><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <Path Data="M2,5 H8 L10,7 H18 V16 H2 Z" Stroke="#A3A9B7" StrokeThickness="1.4" StrokeLineJoin="Round" VerticalAlignment="Top" Margin="0,2,0,0"/>
            <StackPanel Grid.Column="1">
              <TextBlock Text="Installs for your Windows account" Style="{StaticResource RowTitle}"/>
              <TextBlock x:Name="DirText" Style="{StaticResource RowText}" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap"/>
              <TextBox x:Name="DirBox" Style="{StaticResource Field}" Margin="0,6,0,0" Visibility="Collapsed"/>
            </StackPanel>
            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Top" Margin="12,0,0,0">
              <Button x:Name="ChangeBtn" Style="{StaticResource Link}" Content="Change"/>
              <Button x:Name="BrowseBtn" Style="{StaticResource Link}" Content="Browse…" Visibility="Collapsed" Margin="12,0,0,0"/>
            </StackPanel>
          </Grid>
          <Grid Style="{StaticResource Row}">
            <Grid.ColumnDefinitions><ColumnDefinition Width="28"/><ColumnDefinition/></Grid.ColumnDefinitions>
            <Path Data="M2,2 H8 V8 H2 Z M11,2 H17 V8 H11 Z M2,11 H8 V17 H2 Z M11,11 H17 V17 H11 Z" Stroke="#A3A9B7" StrokeThickness="1.4" VerticalAlignment="Top" Margin="0,2,0,0"/>
            <StackPanel Grid.Column="1">
              <TextBlock Text="Adds Quillwave to the Start menu" Style="{StaticResource RowTitle}"/>
              <CheckBox x:Name="DesktopBox" Style="{StaticResource Check}" IsChecked="True" Margin="0,8,0,0"><TextBlock Text="Also add a shortcut to the desktop" FontSize="12.5"/></CheckBox>
            </StackPanel>
          </Grid>
          <Grid Style="{StaticResource Row}">
            <Grid.ColumnDefinitions><ColumnDefinition Width="28"/><ColumnDefinition/></Grid.ColumnDefinitions>
            <Path Data="M10,2 L17,5 V10 C17,14 14,17 10,18 C6,17 3,14 3,10 V5 Z" Stroke="#A3A9B7" StrokeThickness="1.4" StrokeLineJoin="Round" VerticalAlignment="Top" Margin="0,2,0,0"/>
            <StackPanel Grid.Column="1">
              <TextBlock x:Name="SizeTitle" Text="No admin rights needed" Style="{StaticResource RowTitle}"/>
              <TextBlock Text="Nothing else is installed: no add-ons, toolbars or background services." Style="{StaticResource RowText}"/>
            </StackPanel>
          </Grid>
          <Grid Style="{StaticResource Row}">
            <Grid.ColumnDefinitions><ColumnDefinition Width="28"/><ColumnDefinition/></Grid.ColumnDefinitions>
            <Path Data="M4,3 L16,10 L4,17 Z" Stroke="#A3A9B7" StrokeThickness="1.4" StrokeLineJoin="Round" VerticalAlignment="Top" Margin="0,2,0,0"/>
            <StackPanel Grid.Column="1">
              <TextBlock x:Name="AfterTitle" Text="Then Quillwave opens" Style="{StaticResource RowTitle}"/>
              <TextBlock x:Name="AfterText" Text="A short first-run setup picks your topics and how often it checks for news. You'll accept the terms there." Style="{StaticResource RowText}"/>
            </StackPanel>
          </Grid>
        </StackPanel>

        <!-- working: progress, the steps, and (for updates) what's new -->
        <Grid x:Name="ProgressPage" Visibility="Collapsed">
          <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition x:Name="NotesCol" Width="0"/></Grid.ColumnDefinitions>
          <StackPanel>
            <Grid>
              <TextBlock x:Name="StatusText" Text="Getting ready…" Foreground="{StaticResource Muted}" FontSize="12.5" TextTrimming="CharacterEllipsis" Margin="0,0,52,0"/>
              <TextBlock x:Name="PercentText" Text="0%" HorizontalAlignment="Right" FontSize="12.5" FontWeight="SemiBold"/>
            </Grid>
            <Grid Height="6" Margin="0,10,0,22">
              <Border CornerRadius="3" Background="#2A2D38"/>
              <Border x:Name="BarFill" CornerRadius="3" Background="{StaticResource Accent}" HorizontalAlignment="Left" Width="0"/>
            </Grid>
            <ItemsControl x:Name="StepList"/>
          </StackPanel>
          <Border x:Name="NotesPanel" Grid.Column="1" Style="{StaticResource Panel}" Margin="20,-4,0,8" Visibility="Collapsed">
            <StackPanel>
              <TextBlock x:Name="NotesTitle" Text="WHAT'S NEW" Style="{StaticResource Label}"/>
              <ItemsControl x:Name="NotesList"/>
            </StackPanel>
          </Border>
        </Grid>

        <!-- finished -->
        <StackPanel x:Name="DonePage" Visibility="Collapsed">
          <TextBlock x:Name="DoneText" Foreground="{StaticResource Muted}" FontSize="13.5" TextWrapping="Wrap" LineHeight="21"/>
          <CheckBox x:Name="LaunchBox" Style="{StaticResource Check}" IsChecked="True" Margin="0,18,0,0" Visibility="Collapsed"><TextBlock Text="Open Quillwave now" FontSize="13"/></CheckBox>
          <Border x:Name="DoneNotes" Style="{StaticResource Panel}" Margin="0,18,0,0" Visibility="Collapsed">
            <StackPanel>
              <TextBlock x:Name="DoneNotesTitle" Text="WHAT'S NEW" Style="{StaticResource Label}"/>
              <ItemsControl x:Name="DoneNotesList"/>
            </StackPanel>
          </Border>
        </StackPanel>

        <!-- something went wrong -->
        <StackPanel x:Name="ErrorPage" Visibility="Collapsed">
          <Border Style="{StaticResource Panel}" Padding="16,14">
            <TextBlock x:Name="ErrorText" FontSize="13" TextWrapping="Wrap" LineHeight="20"/>
          </Border>
          <TextBlock Foreground="{StaticResource Muted}" FontSize="12.5" TextWrapping="Wrap" Margin="0,14,0,0"
                     Text="If it keeps happening, restart Windows and try again, or email us and we'll help."/>
        </StackPanel>

        <!-- uninstall: what goes, what stays -->
        <StackPanel x:Name="RemovePage" Visibility="Collapsed">
          <Grid>
            <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="14"/><ColumnDefinition/></Grid.ColumnDefinitions>
            <Border Style="{StaticResource Panel}">
              <StackPanel>
                <TextBlock Text="WILL BE REMOVED" Style="{StaticResource Label}"/>
                <TextBlock x:Name="RemoveApp" Text="• The app" Style="{StaticResource RowText}" Margin="0,0,0,7" Foreground="#ECEEF3"/>
                <TextBlock Text="• Start menu and desktop shortcuts" Style="{StaticResource RowText}" Margin="0,0,0,7" Foreground="#ECEEF3"/>
                <TextBlock Text="• Starting with Windows" Style="{StaticResource RowText}" Margin="0,0,0,7" Foreground="#ECEEF3"/>
                <TextBlock Text="• Its entry in Installed apps" Style="{StaticResource RowText}" Margin="0,0,0,10" Foreground="#ECEEF3"/>
              </StackPanel>
            </Border>
            <Border Grid.Column="2" Style="{StaticResource Panel}">
              <StackPanel>
                <TextBlock Text="STAYS" Style="{StaticResource Label}"/>
                <TextBlock Text="• Your Quillwave account, Pro plan and synced notes" Style="{StaticResource RowText}" Margin="0,0,0,7" Foreground="#ECEEF3"/>
                <TextBlock x:Name="StaysLocal" Text="• Settings, bookmarks, offline notes and past chats on this PC" Style="{StaticResource RowText}" Margin="0,0,0,10" Foreground="#ECEEF3"/>
              </StackPanel>
            </Border>
          </Grid>
          <CheckBox x:Name="DeleteDataBox" Style="{StaticResource Check}" Margin="0,16,0,0">
            <StackPanel>
              <TextBlock Text="Also delete my data on this PC" FontSize="13" FontWeight="SemiBold"/>
              <TextBlock x:Name="DataText" Text="Settings, bookmarks, saved articles, offline notes and past chats. Notes synced to your account stay there." Foreground="{StaticResource Muted}" FontSize="12.5" TextWrapping="Wrap" Margin="0,2,0,0"/>
            </StackPanel>
          </CheckBox>
          <TextBlock Foreground="{StaticResource Faint}" FontSize="12" TextWrapping="Wrap" Margin="0,14,0,0"
                     Text="Want your account gone too? Open Quillwave and go to Settings → Account → Delete account before you uninstall."/>
        </StackPanel>
      </Grid>

      <!-- footer: always the same place for the buttons -->
      <Border Grid.Row="3" BorderBrush="{StaticResource Line}" BorderThickness="0,1,0,0" Background="#13141A" CornerRadius="0,0,12,12">
        <Grid Margin="32,0,20,0">
          <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
            <TextBlock x:Name="FootText" Foreground="{StaticResource Faint}" FontSize="12" VerticalAlignment="Center"/>
            <Button x:Name="HelpBtn" Style="{StaticResource Link}" Content="Get help" FontSize="12" Margin="12,0,0,0" Visibility="Collapsed" VerticalAlignment="Center"/>
          </StackPanel>
          <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
            <Button x:Name="SecondaryBtn" Style="{StaticResource Btn}" Content="Cancel"/>
            <Button x:Name="PrimaryBtn" Style="{StaticResource Primary}" Content="Install" Margin="10,0,0,0" IsDefault="True"/>
          </StackPanel>
        </Grid>
      </Border>
    </Grid>
  </Grid>
</Window>
