<Window x:Class="AIPulseSetup.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Quillwave Setup" Width="680" Height="500"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ResizeMode="NoResize" WindowStartupLocation="CenterScreen"
        UseLayoutRounding="True" TextOptions.TextFormattingMode="Display"
        FontFamily="Segoe UI Variable Text, Segoe UI" FontSize="13" Foreground="#ECEEF3">

  <!-- Calm on purpose: one surface, one accent, a fixed layout (header, content,
       footer). The only things that move are the progress bar and short fades. -->
  <Window.Resources>
    <SolidColorBrush x:Key="Surface" Color="#16171D"/>
    <SolidColorBrush x:Key="Raised" Color="#1E2028"/>
    <SolidColorBrush x:Key="Line" Color="#2C2F3A"/>
    <SolidColorBrush x:Key="Muted" Color="#A3A9B7"/>
    <SolidColorBrush x:Key="Faint" Color="#7D8494"/>
    <SolidColorBrush x:Key="Accent" Color="#7B68F6"/>
    <SolidColorBrush x:Key="AccentHover" Color="#8C7BFF"/>
    <SolidColorBrush x:Key="DangerBrush" Color="#D9434E"/>
    <SolidColorBrush x:Key="DangerHover" Color="#E5545E"/>
    <SolidColorBrush x:Key="Good" Color="#3DC98A"/>
    <SolidColorBrush x:Key="TextBright" Color="#ECEEF3"/>
    <FontFamily x:Key="Display">Segoe UI Variable Display Semibold, Segoe UI Semibold</FontFamily>

    <Style x:Key="Btn" TargetType="Button">
      <Setter Property="Foreground" Value="#ECEEF3"/>
      <Setter Property="Background" Value="#262833"/>
      <Setter Property="BorderBrush" Value="#343745"/>
      <Setter Property="FontSize" Value="13"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="Padding" Value="18,0"/>
      <Setter Property="Height" Value="34"/>
      <Setter Property="MinWidth" Value="96"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="b" CornerRadius="7" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" Padding="{TemplateBinding Padding}">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="b" Property="Background" Value="#2E3140"/></Trigger>
              <Trigger Property="IsPressed" Value="True"><Setter TargetName="b" Property="Opacity" Value="0.85"/></Trigger>
              <Trigger Property="IsEnabled" Value="False"><Setter TargetName="b" Property="Opacity" Value="0.4"/></Trigger>
              <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="b" Property="BorderBrush" Value="#B4A9FF"/></Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style x:Key="Primary" TargetType="Button" BasedOn="{StaticResource Btn}">
      <Setter Property="Foreground" Value="White"/>
      <Setter Property="Background" Value="{StaticResource Accent}"/>
      <Setter Property="BorderBrush" Value="{StaticResource Accent}"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="b" CornerRadius="7" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" Padding="{TemplateBinding Padding}">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="b" Property="Opacity" Value="0.9"/></Trigger>
              <Trigger Property="IsPressed" Value="True"><Setter TargetName="b" Property="Opacity" Value="0.8"/></Trigger>
              <Trigger Property="IsEnabled" Value="False"><Setter TargetName="b" Property="Opacity" Value="0.4"/></Trigger>
              <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="b" Property="BorderBrush" Value="White"/></Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style x:Key="Danger" TargetType="Button" BasedOn="{StaticResource Primary}">
      <Setter Property="Background" Value="{StaticResource DangerBrush}"/>
      <Setter Property="BorderBrush" Value="{StaticResource DangerBrush}"/>
    </Style>
    <Style x:Key="Link" TargetType="Button">
      <Setter Property="Foreground" Value="#B4A9FF"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <TextBlock x:Name="t" Text="{TemplateBinding Content}" Foreground="{TemplateBinding Foreground}"/>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="t" Property="TextDecorations" Value="Underline"/></Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style x:Key="Chrome" TargetType="Button">
      <Setter Property="Width" Value="40"/>
      <Setter Property="Height" Value="32"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="b" CornerRadius="6" Background="Transparent"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="b" Property="Background" Value="#262833"/></Trigger>
              <Trigger Property="IsEnabled" Value="False"><Setter TargetName="b" Property="Opacity" Value="0.35"/></Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style x:Key="Check" TargetType="CheckBox">
      <Setter Property="Foreground" Value="#ECEEF3"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="CheckBox">
            <Grid Background="Transparent">
              <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition/></Grid.ColumnDefinitions>
              <Border x:Name="box" Width="18" Height="18" CornerRadius="4" BorderBrush="#4A4E5E" BorderThickness="1.5" Background="Transparent" VerticalAlignment="Top" Margin="0,1,0,0">
                <Path x:Name="tick" Data="M3.5,9 L7.5,13 L14.5,5" Stroke="White" StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" Visibility="Collapsed"/>
              </Border>
              <ContentPresenter Grid.Column="1" Margin="10,0,0,0" VerticalAlignment="Top"/>
            </Grid>
            <ControlTemplate.Triggers>
              <Trigger Property="IsChecked" Value="True">
                <Setter TargetName="box" Property="Background" Value="{StaticResource Accent}"/>
                <Setter TargetName="box" Property="BorderBrush" Value="{StaticResource Accent}"/>
                <Setter TargetName="tick" Property="Visibility" Value="Visible"/>
              </Trigger>
              <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="box" Property="BorderBrush" Value="#B4A9FF"/></Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <!-- a card you can switch on and off: icon, title, line, and a sliding switch -->
    <Style x:Key="OptionCard" TargetType="CheckBox">
      <Setter Property="Foreground" Value="#ECEEF3"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="CheckBox">
            <Border x:Name="card" CornerRadius="10" Background="#1B1D25" BorderBrush="#2C2F3A" BorderThickness="1" Padding="14,12">
              <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <ContentPresenter VerticalAlignment="Center"/>
                <Border x:Name="track" Grid.Column="1" Width="36" Height="20" CornerRadius="10" Background="#2E3140" BorderBrush="#454959" BorderThickness="1" VerticalAlignment="Center" Margin="12,0,0,0">
                  <Ellipse x:Name="knob" Width="14" Height="14" Fill="#A3A9B7" HorizontalAlignment="Left" Margin="2,0,0,0">
                    <Ellipse.RenderTransform><TranslateTransform x:Name="knobX" X="0"/></Ellipse.RenderTransform>
                  </Ellipse>
                </Border>
              </Grid>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsChecked" Value="True">
                <Setter TargetName="card" Property="Background" Value="#211E33"/>
                <Setter TargetName="card" Property="BorderBrush" Value="#5B4FC4"/>
                <Setter TargetName="track" Property="Background" Value="{StaticResource Accent}"/>
                <Setter TargetName="track" Property="BorderBrush" Value="{StaticResource Accent}"/>
                <Setter TargetName="knob" Property="Fill" Value="White"/>
                <Trigger.EnterActions><BeginStoryboard><Storyboard><DoubleAnimation Storyboard.TargetName="knobX" Storyboard.TargetProperty="X" To="16" Duration="0:0:0.18"><DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction></DoubleAnimation></Storyboard></BeginStoryboard></Trigger.EnterActions>
                <Trigger.ExitActions><BeginStoryboard><Storyboard><DoubleAnimation Storyboard.TargetName="knobX" Storyboard.TargetProperty="X" To="0" Duration="0:0:0.18"><DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction></DoubleAnimation></Storyboard></BeginStoryboard></Trigger.ExitActions>
              </Trigger>
              <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="card" Property="BorderBrush" Value="#6E62D8"/></Trigger>
              <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="card" Property="BorderBrush" Value="#B4A9FF"/></Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style x:Key="Card" TargetType="Border"><Setter Property="Background" Value="#1B1D25"/><Setter Property="BorderBrush" Value="#2C2F3A"/><Setter Property="BorderThickness" Value="1"/><Setter Property="CornerRadius" Value="10"/><Setter Property="Padding" Value="14,12"/></Style>
    <Style x:Key="Chip" TargetType="Border"><Setter Property="Background" Value="#1E2029"/><Setter Property="BorderBrush" Value="#2C2F3A"/><Setter Property="BorderThickness" Value="1"/><Setter Property="CornerRadius" Value="999"/><Setter Property="Padding" Value="10,5"/><Setter Property="Margin" Value="0,0,8,0"/></Style>
    <Style x:Key="IconTile" TargetType="Border"><Setter Property="Width" Value="34"/><Setter Property="Height" Value="34"/><Setter Property="CornerRadius" Value="9"/><Setter Property="Background" Value="#262338"/><Setter Property="Margin" Value="0,0,12,0"/><Setter Property="VerticalAlignment" Value="Center"/></Style>
    <Style x:Key="Field" TargetType="TextBox">
      <Setter Property="Foreground" Value="#ECEEF3"/>
      <Setter Property="CaretBrush" Value="#B4A9FF"/>
      <Setter Property="Background" Value="#111218"/>
      <Setter Property="Padding" Value="8,6"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="TextBox">
            <Border x:Name="b" CornerRadius="6" Background="{TemplateBinding Background}" BorderBrush="#343745" BorderThickness="1">
              <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}"/>
            </Border>
            <ControlTemplate.Triggers><Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="b" Property="BorderBrush" Value="#7B68F6"/></Trigger></ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <!-- a row in a list: icon, then text -->
    <Style x:Key="Row" TargetType="Grid"><Setter Property="Margin" Value="0,0,0,12"/></Style>
    <Style x:Key="RowTitle" TargetType="TextBlock"><Setter Property="FontSize" Value="13"/><Setter Property="FontWeight" Value="SemiBold"/><Setter Property="TextWrapping" Value="Wrap"/></Style>
    <Style x:Key="RowText" TargetType="TextBlock"><Setter Property="FontSize" Value="12.5"/><Setter Property="Foreground" Value="{StaticResource Muted}"/><Setter Property="TextWrapping" Value="Wrap"/><Setter Property="Margin" Value="0,2,0,0"/></Style>
    <Style x:Key="Label" TargetType="TextBlock"><Setter Property="FontSize" Value="11"/><Setter Property="FontWeight" Value="SemiBold"/><Setter Property="Foreground" Value="{StaticResource Faint}"/><Setter Property="Margin" Value="0,0,0,10"/></Style>
    <Style x:Key="Panel" TargetType="Border"><Setter Property="Background" Value="{StaticResource Raised}"/><Setter Property="BorderBrush" Value="{StaticResource Line}"/><Setter Property="BorderThickness" Value="1"/><Setter Property="CornerRadius" Value="10"/><Setter Property="Padding" Value="16,14,16,4"/></Style>
  </Window.Resources>

  <Grid x:Name="Shell" Margin="16" Opacity="0">
    <Border CornerRadius="12" Background="{StaticResource Surface}" BorderBrush="{StaticResource Line}" BorderThickness="1">
      <Border.Effect><DropShadowEffect BlurRadius="28" ShadowDepth="6" Opacity="0.45" Color="Black"/></Border.Effect>
    </Border>

    <Grid x:Name="Card">
      <Grid.RowDefinitions>
        <RowDefinition Height="40"/>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="*"/>
        <RowDefinition Height="64"/>
      </Grid.RowDefinitions>

      <!-- title bar -->
      <Grid x:Name="TitleBar" Background="Transparent">
        <StackPanel Orientation="Horizontal" Margin="16,0,0,0" VerticalAlignment="Center">
          <Image Width="16" Height="16" Source="pack://application:,,,/logo.png" RenderOptions.BitmapScalingMode="HighQuality"/>
          <TextBlock x:Name="WindowTitle" Text="Quillwave Setup" Foreground="{StaticResource Muted}" FontSize="12" Margin="9,0,0,0" VerticalAlignment="Center"/>
        </StackPanel>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,0,6,0">
          <Button x:Name="MinBtn" Style="{StaticResource Chrome}" ToolTip="Minimize" AutomationProperties.Name="Minimize"><Path Data="M0,0 H10" Stroke="#A3A9B7" StrokeThickness="1.2"/></Button>
          <Button x:Name="CloseBtn" Style="{StaticResource Chrome}" ToolTip="Close" AutomationProperties.Name="Close"><Path Data="M0,0 L10,10 M10,0 L0,10" Stroke="#A3A9B7" StrokeThickness="1.2"/></Button>
        </StackPanel>
      </Grid>

      <!-- header: logo, title, one line under it -->
      <Grid Grid.Row="1" Margin="32,10,32,18">
        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition/></Grid.ColumnDefinitions>
        <Grid Width="52" Height="52" VerticalAlignment="Top">
          <Border x:Name="Logo" CornerRadius="13">
            <Border.Effect><DropShadowEffect BlurRadius="18" ShadowDepth="3" Opacity="0.45" Color="#6D4DE8"/></Border.Effect>
            <Image Source="pack://application:,,,/logo.png" RenderOptions.BitmapScalingMode="HighQuality"/>
          </Border>
          <Border x:Name="StateBadge" Width="52" Height="52" CornerRadius="13" Visibility="Collapsed">
            <Path x:Name="StateIcon" Width="24" Height="24" Stretch="Uniform" Stroke="White" StrokeThickness="2.4" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"/>
          </Border>
        </Grid>
        <StackPanel Grid.Column="1" Margin="16,2,0,0" VerticalAlignment="Center">
          <TextBlock x:Name="HeadTitle" Text="Install Quillwave" FontFamily="{StaticResource Display}" FontSize="22"/>
          <TextBlock x:Name="HeadSub" Text="" Foreground="{StaticResource Muted}" FontSize="13" Margin="0,3,0,0" TextTrimming="CharacterEllipsis"/>
        </StackPanel>
      </Grid>

      <Grid x:Name="Pages" Grid.Row="2" Margin="32,0,32,0">

        <!-- install: where it goes, which shortcuts, and what to expect -->
        <StackPanel x:Name="WelcomePage" Visibility="Collapsed">
          <Border Style="{StaticResource Card}" Margin="0,0,0,10">
            <Grid>
              <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
              <Border Style="{StaticResource IconTile}"><Path Data="M2,5 H8 L10,7 H18 V16 H2 Z" Stroke="#B4A9FF" StrokeThickness="1.5" StrokeLineJoin="Round" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
              <StackPanel Grid.Column="1" VerticalAlignment="Center">
                <TextBlock Text="Install location" Style="{StaticResource RowTitle}"/>
                <TextBlock x:Name="DirText" Style="{StaticResource RowText}" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap"/>
                <TextBox x:Name="DirBox" Style="{StaticResource Field}" Margin="0,6,0,0" Visibility="Collapsed"/>
              </StackPanel>
              <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="12,0,0,0">
                <Button x:Name="ChangeBtn" Style="{StaticResource Link}" Content="Change"/>
                <Button x:Name="BrowseBtn" Style="{StaticResource Link}" Content="Browse…" Visibility="Collapsed" Margin="12,0,0,0"/>
              </StackPanel>
            </Grid>
          </Border>

          <Grid Margin="0,0,0,12">
            <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="10"/><ColumnDefinition/></Grid.ColumnDefinitions>
            <Border Style="{StaticResource Card}">
              <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <Border Style="{StaticResource IconTile}"><Path Data="M2,2 H8 V8 H2 Z M11,2 H17 V8 H11 Z M2,11 H8 V17 H2 Z M11,11 H17 V17 H11 Z" Stroke="#B4A9FF" StrokeThickness="1.5" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                  <TextBlock Text="Start menu" Style="{StaticResource RowTitle}"/>
                  <TextBlock Text="Search for Quillwave" Style="{StaticResource RowText}"/>
                </StackPanel>
                <Border Grid.Column="2" CornerRadius="999" Background="#1F3A2E" Padding="8,2" VerticalAlignment="Center"><TextBlock Text="Always" FontSize="11" FontWeight="SemiBold" Foreground="#7EE8B8"/></Border>
              </Grid>
            </Border>
            <CheckBox x:Name="DesktopBox" Grid.Column="2" Style="{StaticResource OptionCard}" IsChecked="True" AutomationProperties.Name="Add a desktop shortcut">
              <StackPanel Orientation="Horizontal">
                <Border Style="{StaticResource IconTile}"><Path Data="M2,3 H18 V13 H2 Z M7,17 H13 M10,13 V17" Stroke="#B4A9FF" StrokeThickness="1.5" StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
                <StackPanel VerticalAlignment="Center">
                  <TextBlock Text="Desktop shortcut" Style="{StaticResource RowTitle}"/>
                  <TextBlock Text="One click to open" Style="{StaticResource RowText}"/>
                </StackPanel>
              </StackPanel>
            </CheckBox>
          </Grid>

          <WrapPanel Margin="0,0,0,14">
            <Border Style="{StaticResource Chip}"><StackPanel Orientation="Horizontal"><Ellipse Width="6" Height="6" Fill="#7EE8B8" Margin="0,0,7,0" VerticalAlignment="Center"/><TextBlock x:Name="SizeTitle" Text="No admin rights needed" FontSize="12" Foreground="#C9CDD8"/></StackPanel></Border>
            <Border Style="{StaticResource Chip}"><StackPanel Orientation="Horizontal"><Ellipse Width="6" Height="6" Fill="#B4A9FF" Margin="0,0,7,0" VerticalAlignment="Center"/><TextBlock Text="Updates itself" FontSize="12" Foreground="#C9CDD8"/></StackPanel></Border>
            <Border Style="{StaticResource Chip}"><StackPanel Orientation="Horizontal"><Ellipse Width="6" Height="6" Fill="#F5C76E" Margin="0,0,7,0" VerticalAlignment="Center"/><TextBlock Text="No add-ons or toolbars" FontSize="12" Foreground="#C9CDD8"/></StackPanel></Border>
          </WrapPanel>

          <Grid>
            <Grid.ColumnDefinitions><ColumnDefinition Width="28"/><ColumnDefinition/></Grid.ColumnDefinitions>
            <Path Data="M4,3 L16,10 L4,17 Z" Fill="#7B68F6" VerticalAlignment="Top" Margin="0,3,0,0" Width="12" Height="13" Stretch="Uniform" HorizontalAlignment="Left"/>
            <StackPanel Grid.Column="1">
              <TextBlock x:Name="AfterTitle" Text="Then Quillwave opens" Style="{StaticResource RowTitle}"/>
              <TextBlock x:Name="AfterText" Text="A short first-run setup picks your topics and how often it checks for news. You'll accept the terms there." Style="{StaticResource RowText}"/>
            </StackPanel>
          </Grid>
        </StackPanel>

        <!-- working: progress, the steps, and (for updates) what's new -->
        <Grid x:Name="ProgressPage" Visibility="Collapsed">
          <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition x:Name="NotesCol" Width="0"/></Grid.ColumnDefinitions>
          <StackPanel>
            <Grid>
              <TextBlock x:Name="StatusText" Text="Getting ready…" Foreground="{StaticResource Muted}" FontSize="12.5" TextTrimming="CharacterEllipsis" Margin="0,0,52,0"/>
              <TextBlock x:Name="PercentText" Text="0%" HorizontalAlignment="Right" FontSize="12.5" FontWeight="SemiBold"/>
            </Grid>
            <Grid Height="6" Margin="0,10,0,22">
              <Border CornerRadius="3" Background="#2A2D38"/>
              <Border x:Name="BarFill" CornerRadius="3" HorizontalAlignment="Left" Width="0">
                <Border.Background><LinearGradientBrush StartPoint="0,0" EndPoint="1,0"><GradientStop Color="#6D5BF6" Offset="0"/><GradientStop Color="#A99BFF" Offset="1"/></LinearGradientBrush></Border.Background>
                <Border.Effect><DropShadowEffect BlurRadius="10" ShadowDepth="0" Opacity="0.6" Color="#7B68F6"/></Border.Effect>
              </Border>
            </Grid>
            <ItemsControl x:Name="StepList"/>
            <Border x:Name="TipsPanel" Style="{StaticResource Card}" Margin="0,14,0,0">
              <StackPanel>
                <TextBlock Text="GOOD TO KNOW" Style="{StaticResource Label}"/>
                <Grid Margin="0,0,0,8"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition/></Grid.ColumnDefinitions>
                  <Border CornerRadius="5" Background="#262338" Padding="6,1" VerticalAlignment="Top" Margin="0,0,10,0"><TextBlock Text="Ctrl K" FontSize="11" FontWeight="SemiBold" Foreground="#B4A9FF"/></Border>
                  <TextBlock Grid.Column="1" Text="Jump to any story, setting or command from anywhere in the app." Style="{StaticResource RowText}" Margin="0"/></Grid>
                <Grid Margin="0,0,0,8"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition/></Grid.ColumnDefinitions>
                  <Border CornerRadius="5" Background="#262338" Padding="6,1" VerticalAlignment="Top" Margin="0,0,10,0"><TextBlock Text="Brief me" FontSize="11" FontWeight="SemiBold" Foreground="#B4A9FF"/></Border>
                  <TextBlock Grid.Column="1" Text="The assistant reads the day's news and sums it up in a minute." Style="{StaticResource RowText}" Margin="0"/></Grid>
                <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition/></Grid.ColumnDefinitions>
                  <Border CornerRadius="5" Background="#1F3A2E" Padding="6,1" VerticalAlignment="Top" Margin="0,0,10,0"><TextBlock Text="Feedback" FontSize="11" FontWeight="SemiBold" Foreground="#7EE8B8"/></Border>
                  <TextBlock Grid.Column="1" Text="Spot something odd? Tell us from Ctrl K → Send feedback." Style="{StaticResource RowText}" Margin="0"/></Grid>
              </StackPanel>
            </Border>
          </StackPanel>
          <Border x:Name="NotesPanel" Grid.Column="1" Style="{StaticResource Panel}" Margin="20,-4,0,8" Visibility="Collapsed">
            <StackPanel>
              <TextBlock x:Name="NotesTitle" Text="WHAT'S NEW" Style="{StaticResource Label}"/>
              <ItemsControl x:Name="NotesList"/>
            </StackPanel>
          </Border>
        </Grid>

        <!-- finished -->
        <StackPanel x:Name="DonePage" Visibility="Collapsed">
          <TextBlock x:Name="DoneText" Foreground="{StaticResource Muted}" FontSize="13.5" TextWrapping="Wrap" LineHeight="21"/>
          <CheckBox x:Name="LaunchBox" Style="{StaticResource OptionCard}" IsChecked="True" Margin="0,14,0,0" Visibility="Collapsed" AutomationProperties.Name="Open Quillwave now">
            <StackPanel Orientation="Horizontal">
              <Border Style="{StaticResource IconTile}"><Path Data="M5,3 L16,10 L5,17 Z" Fill="#B4A9FF" Width="11" Height="12" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="2,0,0,0"/></Border>
              <StackPanel VerticalAlignment="Center"><TextBlock Text="Open Quillwave now" Style="{StaticResource RowTitle}"/><TextBlock Text="Starts with a one-minute setup" Style="{StaticResource RowText}"/></StackPanel>
            </StackPanel>
          </CheckBox>
          <Border x:Name="FirstSteps" Style="{StaticResource Card}" Margin="0,12,0,0" Visibility="Collapsed">
            <StackPanel>
              <TextBlock Text="YOUR FIRST MINUTE" Style="{StaticResource Label}"/>
                <Grid Margin="0,0,0,7"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition/></Grid.ColumnDefinitions>
                  <Border Width="22" Height="22" CornerRadius="11" Background="#262338" Margin="0,0,11,0" VerticalAlignment="Top"><TextBlock Text="1" FontSize="11.5" FontWeight="Bold" Foreground="#B4A9FF" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
                  <StackPanel Grid.Column="1"><TextBlock Text="Pick your topics" Style="{StaticResource RowTitle}"/><TextBlock Text="Agents, research, policy: your feed ranks what you care about first." Style="{StaticResource RowText}"/></StackPanel></Grid>
                <Grid Margin="0,0,0,7"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition/></Grid.ColumnDefinitions>
                  <Border Width="22" Height="22" CornerRadius="11" Background="#262338" Margin="0,0,11,0" VerticalAlignment="Top"><TextBlock Text="2" FontSize="11.5" FontWeight="Bold" Foreground="#B4A9FF" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
                  <StackPanel Grid.Column="1"><TextBlock Text="Sign in for the assistant" Style="{StaticResource RowTitle}"/><TextBlock Text="Google or email. Beta testers get extra AI at no cost." Style="{StaticResource RowText}"/></StackPanel></Grid>
                <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition/></Grid.ColumnDefinitions>
                  <Border Width="22" Height="22" CornerRadius="11" Background="#262338" Margin="0,0,11,0" VerticalAlignment="Top"><TextBlock Text="3" FontSize="11.5" FontWeight="Bold" Foreground="#B4A9FF" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
                  <StackPanel Grid.Column="1"><TextBlock Text="Press Brief me" Style="{StaticResource RowTitle}"/><TextBlock Text="The day's AI news, summed up in about a minute." Style="{StaticResource RowText}"/></StackPanel></Grid>
              </StackPanel>
          </Border>
          <Border x:Name="DoneNotes" Style="{StaticResource Panel}" Margin="0,18,0,0" Visibility="Collapsed">
            <StackPanel>
              <TextBlock x:Name="DoneNotesTitle" Text="WHAT'S NEW" Style="{StaticResource Label}"/>
              <ItemsControl x:Name="DoneNotesList"/>
            </StackPanel>
          </Border>
        </StackPanel>

        <!-- something went wrong -->
        <StackPanel x:Name="ErrorPage" Visibility="Collapsed">
          <Border Style="{StaticResource Panel}" Padding="16,14">
            <TextBlock x:Name="ErrorText" FontSize="13" TextWrapping="Wrap" LineHeight="20"/>
          </Border>
          <TextBlock Foreground="{StaticResource Muted}" FontSize="12.5" TextWrapping="Wrap" Margin="0,14,0,0"
                     Text="If it keeps happening, restart Windows and try again, or email us and we'll help."/>
        </StackPanel>

        <!-- uninstall: what goes, what stays -->
        <StackPanel x:Name="RemovePage" Visibility="Collapsed">
          <Grid>
            <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="14"/><ColumnDefinition/></Grid.ColumnDefinitions>
            <Border Style="{StaticResource Panel}">
              <StackPanel>
                <TextBlock Text="WILL BE REMOVED" Style="{StaticResource Label}"/>
                <TextBlock x:Name="RemoveApp" Text="✕  The app" Style="{StaticResource RowText}" Margin="0,0,0,7" Foreground="#ECEEF3"/>
                <TextBlock Text="✕  Start menu and desktop shortcuts" Style="{StaticResource RowText}" Margin="0,0,0,7" Foreground="#ECEEF3"/>
                <TextBlock Text="✕  Starting with Windows" Style="{StaticResource RowText}" Margin="0,0,0,7" Foreground="#ECEEF3"/>
                <TextBlock Text="✕  Its entry in Installed apps" Style="{StaticResource RowText}" Margin="0,0,0,10" Foreground="#ECEEF3"/>
              </StackPanel>
            </Border>
            <Border Grid.Column="2" Style="{StaticResource Panel}">
              <StackPanel>
                <TextBlock Text="STAYS" Style="{StaticResource Label}"/>
                <TextBlock Text="✓  Your Quillwave account, plan and synced notes" Style="{StaticResource RowText}" Margin="0,0,0,7" Foreground="#ECEEF3"/>
                <TextBlock x:Name="StaysLocal" Text="✓  Settings, bookmarks, offline notes and past chats on this PC" Style="{StaticResource RowText}" Margin="0,0,0,10" Foreground="#ECEEF3"/>
              </StackPanel>
            </Border>
          </Grid>
          <CheckBox x:Name="DeleteDataBox" Style="{StaticResource OptionCard}" Margin="0,14,0,0" AutomationProperties.Name="Also delete my data on this PC">
            <Grid>
              <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition/></Grid.ColumnDefinitions>
              <Border Style="{StaticResource IconTile}" Background="#3A2226"><Path Data="M3,5 H17 M8,5 V3 H12 V5 M5,5 L6,17 H14 L15,5" Stroke="#FF9AA2" StrokeThickness="1.5" StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
              <StackPanel Grid.Column="1" VerticalAlignment="Center">
                <TextBlock Text="Also delete my data on this PC" Style="{StaticResource RowTitle}"/>
                <TextBlock x:Name="DataText" Text="Settings, bookmarks, saved articles, offline notes and past chats. Notes synced to your account stay there." Style="{StaticResource RowText}"/>
              </StackPanel>
            </Grid>
          </CheckBox>
          <TextBlock Foreground="{StaticResource Faint}" FontSize="12" TextWrapping="Wrap" Margin="0,14,0,0"
                     Text="Want your account gone too? Open Quillwave and go to Settings → Account → Delete account before you uninstall."/>
        </StackPanel>
      </Grid>

      <!-- footer: always the same place for the buttons -->
      <Border Grid.Row="3" BorderBrush="{StaticResource Line}" BorderThickness="0,1,0,0" Background="#13141A" CornerRadius="0,0,12,12">
        <Grid Margin="32,0,20,0">
          <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
            <TextBlock x:Name="FootText" Foreground="{StaticResource Faint}" FontSize="12" VerticalAlignment="Center"/>
            <Button x:Name="HelpBtn" Style="{StaticResource Link}" Content="Get help" FontSize="12" Margin="12,0,0,0" Visibility="Collapsed" VerticalAlignment="Center"/>
          </StackPanel>
          <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
            <Button x:Name="SecondaryBtn" Style="{StaticResource Btn}" Content="Cancel"/>
            <Button x:Name="PrimaryBtn" Style="{StaticResource Primary}" Content="Install" Margin="10,0,0,0" IsDefault="True"/>
          </StackPanel>
        </Grid>
      </Border>
    </Grid>
  </Grid>
</Window>
