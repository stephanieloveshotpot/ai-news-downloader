<Window x:Class="AIPulseSetup.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="AI Pulse Setup" Width="640" Height="440"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ResizeMode="NoResize" WindowStartupLocation="CenterScreen"
        UseLayoutRounding="True" TextOptions.TextFormattingMode="Display"
        FontFamily="Segoe UI Variable Text, Segoe UI" FontSize="13" Foreground="#E8EEE8">

  <Window.Resources>
    <LinearGradientBrush x:Key="Grad" StartPoint="0,0" EndPoint="1,1">
      <GradientStop Color="#2440F0" Offset="0"/>
      <GradientStop Color="#8B5CF6" Offset="0.55"/>
      <GradientStop Color="#E2640C" Offset="1"/>
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="DangerGrad" StartPoint="0,0" EndPoint="1,1">
      <GradientStop Color="#E0453D" Offset="0"/>
      <GradientStop Color="#B3342E" Offset="1"/>
    </LinearGradientBrush>
    <SolidColorBrush x:Key="Muted" Color="#93A39A"/>
    <SolidColorBrush x:Key="Card" Color="#1AFFFFFF"/>
    <SolidColorBrush x:Key="Edge" Color="#26FFFFFF"/>
    <FontFamily x:Key="Display">Bahnschrift SemiBold, Segoe UI Semibold</FontFamily>

    <!-- big gradient pill with glow, grows a little on hover -->
    <Style x:Key="Primary" TargetType="Button">
      <Setter Property="Foreground" Value="White"/>
      <Setter Property="FontSize" Value="15"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="Padding" Value="34,12"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Background" Value="{StaticResource Grad}"/>
      <Setter Property="RenderTransformOrigin" Value="0.5,0.5"/>
      <Setter Property="RenderTransform"><Setter.Value><ScaleTransform/></Setter.Value></Setter>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="b" CornerRadius="16" Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}">
              <Border.Effect><DropShadowEffect x:Name="glow" Color="#8B5CF6" BlurRadius="22" ShadowDepth="0" Opacity="0.55"/></Border.Effect>
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <EventTrigger RoutedEvent="MouseEnter">
                <BeginStoryboard><Storyboard>
                  <DoubleAnimation Storyboard.TargetProperty="RenderTransform.ScaleX" To="1.05" Duration="0:0:0.25"><DoubleAnimation.EasingFunction><BackEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction></DoubleAnimation>
                  <DoubleAnimation Storyboard.TargetProperty="RenderTransform.ScaleY" To="1.05" Duration="0:0:0.25"><DoubleAnimation.EasingFunction><BackEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction></DoubleAnimation>
                  <DoubleAnimation Storyboard.TargetName="glow" Storyboard.TargetProperty="BlurRadius" To="36" Duration="0:0:0.25"/>
                  <DoubleAnimation Storyboard.TargetName="glow" Storyboard.TargetProperty="Opacity" To="0.85" Duration="0:0:0.25"/>
                </Storyboard></BeginStoryboard>
              </EventTrigger>
              <EventTrigger RoutedEvent="MouseLeave">
                <BeginStoryboard><Storyboard>
                  <DoubleAnimation Storyboard.TargetProperty="RenderTransform.ScaleX" To="1" Duration="0:0:0.2"/>
                  <DoubleAnimation Storyboard.TargetProperty="RenderTransform.ScaleY" To="1" Duration="0:0:0.2"/>
                  <DoubleAnimation Storyboard.TargetName="glow" Storyboard.TargetProperty="BlurRadius" To="22" Duration="0:0:0.2"/>
                  <DoubleAnimation Storyboard.TargetName="glow" Storyboard.TargetProperty="Opacity" To="0.55" Duration="0:0:0.2"/>
                </Storyboard></BeginStoryboard>
              </EventTrigger>
              <Trigger Property="IsPressed" Value="True"><Setter TargetName="b" Property="Opacity" Value="0.85"/></Trigger>
              <Trigger Property="IsEnabled" Value="False"><Setter TargetName="b" Property="Opacity" Value="0.45"/></Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style x:Key="Ghost" TargetType="Button">
      <Setter Property="Foreground" Value="#E8EEE8"/>
      <Setter Property="Padding" Value="18,9"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="b" CornerRadius="12" Background="{StaticResource Card}" BorderBrush="{StaticResource Edge}" BorderThickness="1" Padding="{TemplateBinding Padding}">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="b" Property="Background" Value="#2EFFFFFF"/></Trigger>
              <Trigger Property="IsPressed" Value="True"><Setter TargetName="b" Property="Opacity" Value="0.8"/></Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style x:Key="Link" TargetType="Button">
      <Setter Property="Foreground" Value="#A3AFFF"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <TextBlock x:Name="t" Text="{TemplateBinding Content}" Foreground="{TemplateBinding Foreground}"/>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="t" Property="TextDecorations" Value="Underline"/></Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style x:Key="Chrome" TargetType="Button">
      <Setter Property="Width" Value="34"/>
      <Setter Property="Height" Value="30"/>
      <Setter Property="Foreground" Value="#B9C4BC"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="b" CornerRadius="9" Background="Transparent">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="b" Property="Background" Value="#22FFFFFF"/></Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- toggle switch -->
    <Style x:Key="Switch" TargetType="CheckBox">
      <Setter Property="Foreground" Value="#E8EEE8"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="CheckBox">
            <StackPanel Orientation="Horizontal" Background="Transparent">
              <Grid Width="36" Height="20" VerticalAlignment="Center">
                <Border x:Name="track" CornerRadius="10" Background="#33FFFFFF"/>
                <Ellipse x:Name="knob" Width="16" Height="16" Fill="White" HorizontalAlignment="Left" Margin="2,0,0,0">
                  <Ellipse.RenderTransform><TranslateTransform x:Name="kx"/></Ellipse.RenderTransform>
                </Ellipse>
              </Grid>
              <ContentPresenter Margin="10,0,0,0" VerticalAlignment="Center"/>
            </StackPanel>
            <ControlTemplate.Triggers>
              <Trigger Property="IsChecked" Value="True">
                <Setter TargetName="track" Property="Background" Value="{StaticResource Grad}"/>
                <Trigger.EnterActions><BeginStoryboard><Storyboard><DoubleAnimation Storyboard.TargetName="kx" Storyboard.TargetProperty="X" To="16" Duration="0:0:0.25"><DoubleAnimation.EasingFunction><BackEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction></DoubleAnimation></Storyboard></BeginStoryboard></Trigger.EnterActions>
                <Trigger.ExitActions><BeginStoryboard><Storyboard><DoubleAnimation Storyboard.TargetName="kx" Storyboard.TargetProperty="X" To="0" Duration="0:0:0.2"/></Storyboard></BeginStoryboard></Trigger.ExitActions>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style x:Key="Field" TargetType="TextBox">
      <Setter Property="Foreground" Value="#E8EEE8"/>
      <Setter Property="CaretBrush" Value="#A3AFFF"/>
      <Setter Property="Background" Value="#14FFFFFF"/>
      <Setter Property="BorderBrush" Value="{StaticResource Edge}"/>
      <Setter Property="Padding" Value="8,6"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="TextBox">
            <Border CornerRadius="10" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1">
              <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}"/>
            </Border>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
  </Window.Resources>

  <Grid x:Name="Shell" Margin="18" RenderTransformOrigin="0.5,0.5" Opacity="0">
    <Grid.RenderTransform><ScaleTransform x:Name="ShellScale" ScaleX="0.94" ScaleY="0.94"/></Grid.RenderTransform>
    <Border CornerRadius="24" Background="#0F1411">
      <Border.Effect><DropShadowEffect BlurRadius="30" ShadowDepth="6" Opacity="0.55" Color="Black"/></Border.Effect>
    </Border>

    <!-- everything inside is clipped to the rounded card -->
    <Grid x:Name="Card">
      <!-- background: drifting aurora -->
      <Canvas x:Name="Aurora" IsHitTestVisible="False">
        <Ellipse x:Name="B1" Width="380" Height="380" Fill="#2440F0" Opacity="0.55" Canvas.Left="-120" Canvas.Top="-170"><Ellipse.Effect><BlurEffect Radius="120"/></Ellipse.Effect></Ellipse>
        <Ellipse x:Name="B2" Width="340" Height="340" Fill="#8B5CF6" Opacity="0.45" Canvas.Left="360" Canvas.Top="180"><Ellipse.Effect><BlurEffect Radius="120"/></Ellipse.Effect></Ellipse>
        <Ellipse x:Name="B3" Width="260" Height="260" Fill="#E2640C" Opacity="0.30" Canvas.Left="420" Canvas.Top="-120"><Ellipse.Effect><BlurEffect Radius="110"/></Ellipse.Effect></Ellipse>
      </Canvas>
      <Border CornerRadius="24" BorderBrush="#22FFFFFF" BorderThickness="1" IsHitTestVisible="False"/>

      <!-- title bar -->
      <Grid x:Name="TitleBar" Height="44" VerticalAlignment="Top" Background="Transparent">
        <StackPanel Orientation="Horizontal" Margin="18,0,0,0" VerticalAlignment="Center">
          <TextBlock Text="AI Pulse Setup" Foreground="{StaticResource Muted}" FontSize="12"/>
        </StackPanel>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,0,10,0">
          <Button x:Name="MinBtn" Style="{StaticResource Chrome}" ToolTip="Minimize"><Path Data="M0,0 H10" Stroke="#B9C4BC" StrokeThickness="1.4"/></Button>
          <Button x:Name="CloseBtn" Style="{StaticResource Chrome}" ToolTip="Close"><Path Data="M0,0 L10,10 M10,0 L0,10" Stroke="#B9C4BC" StrokeThickness="1.4"/></Button>
        </StackPanel>
      </Grid>

      <!-- logo: gradient tile with a self-drawing pulse line -->
      <Grid x:Name="LogoHost" Width="96" Height="96" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,52,0,0" RenderTransformOrigin="0.5,0.5">
        <Grid.RenderTransform><TransformGroup><ScaleTransform x:Name="LogoScale" ScaleX="0.4" ScaleY="0.4"/><TranslateTransform x:Name="LogoFloat"/></TransformGroup></Grid.RenderTransform>
        <Border CornerRadius="28" Background="{StaticResource Grad}">
          <Border.Effect><DropShadowEffect x:Name="LogoGlow" Color="#8B5CF6" BlurRadius="40" ShadowDepth="0" Opacity="0.7"/></Border.Effect>
        </Border>
        <Viewbox Margin="20">
          <Canvas Width="24" Height="24">
            <Path x:Name="PulseLine" Data="M2,13 H5 L7,7 L10,19 L13,5 L16,15 L18,11 H22" Stroke="White" StrokeThickness="2"
                  StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeDashArray="34 34" StrokeDashOffset="34"/>
          </Canvas>
        </Viewbox>
      </Grid>

      <!-- pages -->
      <Grid x:Name="Pages" Margin="40,160,40,26">

        <!-- welcome -->
        <StackPanel x:Name="WelcomePage" Visibility="Collapsed" VerticalAlignment="Top">
          <TextBlock Text="AI Pulse" FontFamily="{StaticResource Display}" FontSize="34" HorizontalAlignment="Center"/>
          <TextBlock Text="The day's AI news from 40+ sources, on your desktop." Foreground="{StaticResource Muted}" FontSize="14" HorizontalAlignment="Center" Margin="0,4,0,0"/>
          <Button x:Name="InstallBtn" Style="{StaticResource Primary}" Content="Install" HorizontalAlignment="Center" Margin="0,22,0,0"/>
          <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,16,0,0">
            <TextBlock x:Name="VersionText" Foreground="{StaticResource Muted}" FontSize="12"/>
            <TextBlock Text="  ·  " Foreground="{StaticResource Muted}" FontSize="12"/>
            <Button x:Name="OptionsBtn" Style="{StaticResource Link}" Content="Install options" FontSize="12"/>
          </StackPanel>
          <Border x:Name="OptionsPanel" Visibility="Collapsed" CornerRadius="14" Background="{StaticResource Card}" BorderBrush="{StaticResource Edge}" BorderThickness="1" Padding="14,12" Margin="0,12,0,0">
            <StackPanel>
              <TextBlock Text="Install to" Foreground="{StaticResource Muted}" FontSize="12" Margin="0,0,0,6"/>
              <DockPanel>
                <Button x:Name="BrowseBtn" Style="{StaticResource Ghost}" Content="Browse…" DockPanel.Dock="Right" Margin="8,0,0,0" Padding="12,6"/>
                <TextBox x:Name="DirBox" Style="{StaticResource Field}"/>
              </DockPanel>
              <CheckBox x:Name="DesktopBox" Style="{StaticResource Switch}" Content="Create a desktop shortcut" IsChecked="True" Margin="0,10,0,0"/>
            </StackPanel>
          </Border>
        </StackPanel>

        <!-- progress -->
        <StackPanel x:Name="ProgressPage" Visibility="Collapsed" VerticalAlignment="Top">
          <TextBlock x:Name="ProgressTitle" Text="Installing AI Pulse" FontFamily="{StaticResource Display}" FontSize="24" HorizontalAlignment="Center"/>
          <TextBlock x:Name="PercentText" Text="0%" FontFamily="{StaticResource Display}" FontSize="42" HorizontalAlignment="Center" Margin="0,4,0,6">
            <TextBlock.Foreground>
              <LinearGradientBrush StartPoint="0,0" EndPoint="1,0"><GradientStop Color="#A3AFFF" Offset="0"/><GradientStop Color="#F0A6FF" Offset="1"/></LinearGradientBrush>
            </TextBlock.Foreground>
          </TextBlock>
          <Grid Height="10" Margin="10,0">
            <Border CornerRadius="5" Background="#1FFFFFFF"/>
            <Border x:Name="BarFill" CornerRadius="5" HorizontalAlignment="Left" Width="0" Background="{StaticResource Grad}" ClipToBounds="True">
              <Border.Effect><DropShadowEffect Color="#8B5CF6" BlurRadius="16" ShadowDepth="0" Opacity="0.8"/></Border.Effect>
              <Rectangle x:Name="Shimmer" Width="90" HorizontalAlignment="Left">
                <Rectangle.Fill>
                  <LinearGradientBrush StartPoint="0,0" EndPoint="1,0"><GradientStop Color="#00FFFFFF" Offset="0"/><GradientStop Color="#66FFFFFF" Offset="0.5"/><GradientStop Color="#00FFFFFF" Offset="1"/></LinearGradientBrush>
                </Rectangle.Fill>
                <Rectangle.RenderTransform><TranslateTransform x:Name="ShimmerX" X="-100"/></Rectangle.RenderTransform>
              </Rectangle>
            </Border>
          </Grid>
          <TextBlock x:Name="StatusText" Text="Getting ready…" Foreground="{StaticResource Muted}" FontSize="12" HorizontalAlignment="Center" Margin="0,12,0,0" TextTrimming="CharacterEllipsis" MaxWidth="480"/>
        </StackPanel>

        <!-- done -->
        <StackPanel x:Name="DonePage" Visibility="Collapsed" VerticalAlignment="Top">
          <Grid Width="64" Height="64" HorizontalAlignment="Center">
            <Ellipse x:Name="CheckRing" Stroke="#5CC28A" StrokeThickness="3" StrokeDashArray="60 60" StrokeDashOffset="60"/>
            <Path x:Name="CheckTick" Data="M19,33 L28,42 L46,23" Stroke="#5CC28A" StrokeThickness="3.5" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" StrokeDashArray="14 14" StrokeDashOffset="14"/>
          </Grid>
          <TextBlock x:Name="DoneTitle" Text="AI Pulse is ready" FontFamily="{StaticResource Display}" FontSize="24" HorizontalAlignment="Center" Margin="0,10,0,0"/>
          <TextBlock x:Name="DoneText" Text="Opening it now…" Foreground="{StaticResource Muted}" FontSize="13" HorizontalAlignment="Center" Margin="0,4,0,0"/>
        </StackPanel>

        <!-- error -->
        <StackPanel x:Name="ErrorPage" Visibility="Collapsed" VerticalAlignment="Top">
          <TextBlock Text="Something went wrong" FontFamily="{StaticResource Display}" FontSize="24" HorizontalAlignment="Center" Foreground="#F2A39C"/>
          <TextBlock x:Name="ErrorText" Foreground="{StaticResource Muted}" FontSize="13" TextWrapping="Wrap" TextAlignment="Center" Margin="0,8,0,0" MaxWidth="480"/>
          <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,18,0,0">
            <Button x:Name="RetryBtn" Style="{StaticResource Primary}" Content="Try again" Padding="26,10"/>
            <Button x:Name="ErrorCloseBtn" Style="{StaticResource Ghost}" Content="Close" Margin="10,0,0,0"/>
          </StackPanel>
        </StackPanel>

        <!-- uninstall -->
        <StackPanel x:Name="RemovePage" Visibility="Collapsed" VerticalAlignment="Top">
          <TextBlock Text="Remove AI Pulse?" FontFamily="{StaticResource Display}" FontSize="26" HorizontalAlignment="Center"/>
          <TextBlock Text="The app, its shortcuts and its startup entry will be removed." Foreground="{StaticResource Muted}" FontSize="13" HorizontalAlignment="Center" Margin="0,6,0,0"/>
          <CheckBox x:Name="DeleteDataBox" Style="{StaticResource Switch}" Content="Also delete my settings, bookmarks and saved articles" HorizontalAlignment="Center" Margin="0,18,0,0"/>
          <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,20,0,0">
            <Button x:Name="RemoveBtn" Style="{StaticResource Primary}" Content="Remove" Background="{StaticResource DangerGrad}" Padding="30,11"/>
            <Button x:Name="KeepBtn" Style="{StaticResource Ghost}" Content="Keep it" Margin="10,0,0,0" Padding="22,11"/>
          </StackPanel>
        </StackPanel>
      </Grid>

      <TextBlock x:Name="Footnote" VerticalAlignment="Bottom" HorizontalAlignment="Center" Margin="0,0,0,16" FontSize="11" Foreground="#6E7D74"
                 Text="Installs for your account only, no admin needed. You'll accept the terms when AI Pulse opens."/>
    </Grid>
  </Grid>
</Window>
