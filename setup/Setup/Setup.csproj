<Project Sdk="Microsoft.NET.Sdk">
  <!-- The installer: zips the unpacked app (PayloadDir), with the uninstaller
       built by ../Uninstall added to it, and embeds that one zip. (No loose exe
       inside the exe: that pattern looks like a dropper to antivirus engines.)

       dotnet build Setup.csproj -c Release -p:Version=1.4.0
         -p:PayloadDir=C:\...\payload\app -p:UninstallerExe=C:\...\Uninstall Quillwave.exe -->
  <Import Project="..\src\Common.props" />
  <PropertyGroup>
    <AssemblyName>Quillwave-Setup</AssemblyName>
    <AssemblyTitle>Quillwave Setup</AssemblyTitle>
    <Description>Installs Quillwave, a desktop AI news reader, for the current user.</Description>
    <PayloadDir Condition="'$(PayloadDir)' == ''">$(MSBuildThisFileDirectory)..\..\payload\app</PayloadDir>
    <UninstallerExe Condition="'$(UninstallerExe)' == ''">$(MSBuildThisFileDirectory)..\Uninstall\bin\Release\Uninstall Quillwave.exe</UninstallerExe>
    <PayloadZip>$(MSBuildThisFileDirectory)obj\payload.zip</PayloadZip>
  </PropertyGroup>
  <ItemGroup>
    <EmbeddedResource Include="$(PayloadZip)" LogicalName="payload.zip" />
  </ItemGroup>
  <Target Name="ZipPayload" BeforeTargets="PrepareForBuild">
    <Error Condition="!Exists('$(PayloadDir)\Quillwave.exe')" Text="PayloadDir '$(PayloadDir)' has no Quillwave.exe. Unzip the app bundle first." />
    <Error Condition="!Exists('$(UninstallerExe)')" Text="Build ../Uninstall first: '$(UninstallerExe)' is missing." />
    <MakeDir Directories="$(MSBuildThisFileDirectory)obj" />
    <Copy SourceFiles="$(UninstallerExe)" DestinationFolder="$(PayloadDir)" />
    <ZipDirectory SourceDirectory="$(PayloadDir)" DestinationFile="$(PayloadZip)" Overwrite="true" />
  </Target>
</Project>
